{
  "name": "gitlabbar",
  "productName": "GitLabBar",
  "version": "0.7.0",
  "description": "A macOS menu bar app for GitLab - Track merge requests, pipelines, and releases at a glance",
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prestart": "vite build --config vite.renderer.config.ts",
    "start": "electron-forge start",
    "prepackage": "vite build --config vite.renderer.config.ts",
    "package": "electron-forge package",
    "premake": "vite build --config vite.renderer.config.ts",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "gitlab",
    "menubar",
    "electron",
    "macos",
    "merge-request",
    "pipeline",
    "devtools",
    "productivity"
  ],
  "author": {
    "name": "Yoan Bernabeu",
    "email": "ybernabeu@seineyonne.fr"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoanbernabeu/GitLabBar.git"
  },
  "bugs": {
    "url": "https://github.com/yoanbernabeu/GitLabBar/issues"
  },
  "homepage": "https://github.com/yoanbernabeu/GitLabBar#readme",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^2.1.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.2.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "date-fns": "^4.1.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^14.0.1"
  }
}
